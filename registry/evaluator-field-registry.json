    {"fieldId": "arm.dropout_n", "entity": "Arm", "jsonPointer": "/arms/*/dropout_n", "valueType": "integer", "cardinality": "ZERO_OR_ONE_PER_ARM", "comparator": "exact", "evidenceRequired": true, "legacySources": ["FlowArm.dropout_n"]},

