    {"fieldId": "article.doi", "entity": "Article", "jsonPointer": "/article/doi", "valueType": "string", "cardinality": "ZERO_OR_ONE", "comparator": "doi", "evidenceRequired": true, "legacySources": []},
    {"fieldId": "article.publication_year", "entity": "Article", "jsonPointer": "/article/publication_year", "valueType": "integer", "cardinality": "ZERO_OR_ONE", "comparator": "exact", "evidenceRequired": true, "legacySources": ["MetadataExtraction.publication_year", "Sheet1!H"]},
    {"fieldId": "article.journal", "entity": "Article", "jsonPointer": "/article/journal", "valueType": "string", "cardinality": "ZERO_OR_ONE", "comparator": "normalized_text", "evidenceRequired": true, "legacySources": ["MetadataExtraction.journal", "Sheet1!J"]},
    {"fieldId": "article.language", "entity": "Article", "jsonPointer": "/article/language", "valueType": "string", "cardinality": "ZERO_OR_ONE", "comparator": "casefold_text", "evidenceRequired": true, "legacySources": ["MetadataExtraction.language", "Sheet1!I"]},
