    {"fieldId": "arm_result.change_from_baseline", "entity": "ArmResult", "jsonPointer": "/arm_results/*/change_from_baseline", "valueType": "number", "cardinality": "ZERO_OR_ONE_PER_RESULT", "comparator": "numeric", "evidenceRequired": true, "legacySources": ["OutcomeArm.change"]},
    {"fieldId": "arm_result.n", "entity": "ArmResult", "jsonPointer": "/arm_results/*/n", "valueType": "integer", "cardinality": "ZERO_OR_ONE_PER_RESULT", "comparator": "exact", "evidenceRequired": true, "legacySources": ["OutcomeArm.n", "OutcomeStatistic.intervention_n", "OutcomeStatistic.control_n"]},
