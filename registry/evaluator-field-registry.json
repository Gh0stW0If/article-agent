    {"fieldId": "intervention.frequency_value", "entity": "Intervention", "jsonPointer": "/interventions/*/frequency_value", "valueType": "number", "cardinality": "ZERO_OR_ONE_PER_INTERVENTION", "comparator": "numeric", "evidenceRequired": true, "legacySources": ["AcupunctureProtocol.treatment_frequency_value", "Sheet1!AU"]},
    {"fieldId": "intervention.duration_raw", "entity": "Intervention", "jsonPointer": "/interventions/*/duration_raw", "valueType": "string", "cardinality": "ZERO_OR_ONE_PER_INTERVENTION", "comparator": "normalized_text", "evidenceRequired": true, "legacySources": ["AcupunctureProtocol.treatment_duration_raw", "Sheet1!AX"]},
    {"fieldId": "intervention.duration_value", "entity": "Intervention", "jsonPointer": "/interventions/*/duration_value", "valueType": "number", "cardinality": "ZERO_OR_ONE_PER_INTERVENTION", "comparator": "numeric", "evidenceRequired": true, "legacySources": ["AcupunctureProtocol.treatment_duration_value", "Sheet1!AY"]},
