    {"fieldId": "arm.label", "entity": "Arm", "jsonPointer": "/arms/*/label", "valueType": "string", "cardinality": "ZERO_OR_ONE_PER_ARM", "comparator": "normalized_text", "evidenceRequired": true, "legacySources": ["OutcomeArm.arm_label"]},
