    {"fieldId": "arm.randomized_n", "entity": "Arm", "jsonPointer": "/arms/*/randomized_n", "valueType": "integer", "cardinality": "ZERO_OR_ONE_PER_ARM", "comparator": "exact", "evidenceRequired": true, "legacySources": ["OutcomeArm.n", "RiskOfBiasExtraction.randomized_sample_intervention_raw", "RiskOfBiasExtraction.randomized_sample_control_raw"]},
