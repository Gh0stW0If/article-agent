    {"fieldId": "outcome.unit", "entity": "Outcome", "jsonPointer": "/outcomes/*/unit", "valueType": "string", "cardinality": "ZERO_OR_ONE_PER_OUTCOME", "comparator": "unit", "evidenceRequired": true, "legacySources": ["Sheet3!MUNIT"]},

