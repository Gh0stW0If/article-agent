{
  "schemaVersion": "1.0.0",
  "registryId": "EVALUATOR_FIELD_REGISTRY/1.0.0",
  "canonicalSchema": "schemas/article-extraction.schema.json",
  "canonicalSchemaVersion": "ARTICLE_EXTRACTION/1.0",
  "status": "ACTIVE",
  "purpose": "Allow-list of canonical fields that an evaluator may score. Gold is evaluator-only and is never an extraction input.",
  "defaults": {
    "missingValue": null,
    "numericAbsoluteTolerance": 1e-06,
    "numericRelativeTolerance": 1e-06,
    "unorderedListComparison": true,
    "requireEvidenceForNonMissingCandidate": true
  },
