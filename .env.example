# Copy this file to .env and fill in local values. Never commit .env.
ARTICLE_AGENT_API_KEY=replace-with-your-api-key
ARTICLE_AGENT_API_BASE_URL=https://api.example.com/v1
# chat_completions (default) -> /v1/chat/completions; responses -> /v1/responses
ARTICLE_AGENT_API_MODE=chat_completions
ARTICLE_AGENT_API_FALLBACK_URLS=https://backup-1.example.com/v1,https://backup-2.example.com/v1
ARTICLE_AGENT_MODEL=gpt-5.6-sol
ARTICLE_AGENT_TABLE_CLASSIFIER_MODEL=gpt-5.6-luna
ARTICLE_AGENT_OUTCOME_REQUEST_DELAY_SECONDS=0.01
ARTICLE_AGENT_TLS_VERIFY=1
# Evaluator only; never used by production extraction.
ARTICLE_AGENT_SEMANTIC_JUDGE_MODEL=gpt-5.6-sol
