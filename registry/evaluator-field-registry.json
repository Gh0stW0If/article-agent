    {"fieldId": "study.condition", "entity": "Study", "jsonPointer": "/studies/*/condition", "valueType": "string", "cardinality": "ZERO_OR_ONE_PER_STUDY", "comparator": "normalized_text", "evidenceRequired": true, "legacySources": ["MetadataExtraction.disease_name", "Sheet1!R"]},
    {"fieldId": "study.countries", "entity": "Study", "jsonPointer": "/studies/*/countries", "valueType": "string_list", "cardinality": "ZERO_OR_MANY_PER_STUDY", "comparator": "country_set", "evidenceRequired": true, "legacySources": ["MetadataExtraction.country", "Sheet1!U"]},
    {"fieldId": "study.centre_count", "entity": "Study", "jsonPointer": "/studies/*/centre_count", "valueType": "integer", "cardinality": "ZERO_OR_ONE_PER_STUDY", "comparator": "exact", "evidenceRequired": true, "legacySources": ["Sheet1!W"]},
