    {"fieldId": "comparison.arm_ids", "entity": "Comparison", "jsonPointer": "/comparisons/*/arm_ids", "valueType": "id_list", "cardinality": "ZERO_OR_MANY_PER_COMPARISON", "comparator": "entity_identity_set", "evidenceRequired": true, "legacySources": ["OutcomeComparison.intervention_arm_id", "OutcomeComparison.control_arm_id", "OutcomeComparison.comparator_arm_ids"]},
    {"fieldId": "comparison.contrast", "entity": "Comparison", "jsonPointer": "/comparisons/*/contrast", "valueType": "string", "cardinality": "ZERO_OR_ONE_PER_COMPARISON", "comparator": "normalized_text", "evidenceRequired": true, "legacySources": ["OutcomeComparison.contrast"]},

