    {"fieldId": "comparison_result.confidence_interval_lower", "entity": "ComparisonResult", "jsonPointer": "/comparison_results/*/confidence_interval_lower", "valueType": "number", "cardinality": "ZERO_OR_ONE_PER_RESULT", "comparator": "numeric", "evidenceRequired": true, "legacySources": ["OutcomeStatistic.outcome_between_group_lower"]},
    {"fieldId": "comparison_result.confidence_interval_upper", "entity": "ComparisonResult", "jsonPointer": "/comparison_results/*/confidence_interval_upper", "valueType": "number", "cardinality": "ZERO_OR_ONE_PER_RESULT", "comparator": "numeric", "evidenceRequired": true, "legacySources": ["OutcomeStatistic.outcome_between_group_upper"]},
    {"fieldId": "comparison_result.p_value", "entity": "ComparisonResult", "jsonPointer": "/comparison_results/*/p_value", "valueType": "number", "cardinality": "ZERO_OR_ONE_PER_RESULT", "comparator": "p_value", "evidenceRequired": true, "legacySources": ["OutcomeStatistic.outcome_p_value", "OutcomeStatistic.p_value_cells"]},
    {"fieldId": "comparison_result.p_value_comparator", "entity": "ComparisonResult", "jsonPointer": "/comparison_results/*/p_value_comparator", "valueType": "enum", "cardinality": "ONE_PER_RESULT", "comparator": "exact", "evidenceRequired": true, "legacySources": ["OutcomeStatistic.outcome_p_value_comparator"]},

    {"fieldId": "evidence.quote", "entity": "Evidence", "jsonPointer": "/evidence/*/quote", "valueType": "string", "cardinality": "ONE_PER_EVIDENCE", "comparator": "verbatim_text", "evidenceRequired": false, "legacySources": ["EvidenceQuote.quote", "OutcomeStatistic.source_evidence"]},
    {"fieldId": "evidence.source_type", "entity": "Evidence", "jsonPointer": "/evidence/*/source_type", "valueType": "enum", "cardinality": "ONE_PER_EVIDENCE", "comparator": "exact", "evidenceRequired": false, "legacySources": ["EvidenceQuote.source"]},
    {"fieldId": "evidence.page", "entity": "Evidence", "jsonPointer": "/evidence/*/page", "valueType": "integer", "cardinality": "ZERO_OR_ONE_PER_EVIDENCE", "comparator": "exact", "evidenceRequired": false, "legacySources": ["EvidenceQuote.page"]},
    {"fieldId": "evidence.table_id", "entity": "Evidence", "jsonPointer": "/evidence/*/table_id", "valueType": "string", "cardinality": "ZERO_OR_ONE_PER_EVIDENCE", "comparator": "exact", "evidenceRequired": false, "legacySources": ["OutcomeStatistic.table_id"]},
    {"fieldId": "evidence.row_id", "entity": "Evidence", "jsonPointer": "/evidence/*/row_id", "valueType": "string", "cardinality": "ZERO_OR_ONE_PER_EVIDENCE", "comparator": "exact", "evidenceRequired": false, "legacySources": ["OutcomeStatistic.row_id"]}
